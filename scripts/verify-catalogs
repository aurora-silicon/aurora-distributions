#!/bin/bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# OpenSSL's Ed25519 SubjectPublicKeyInfo header followed by the raw 32-byte key.
key=$(mktemp);trap 'rm -f "$key"' EXIT
python3 - "$root/keys/catalog.ed25519.pub" "$key" <<'PY'
from pathlib import Path
import sys
key=Path(sys.argv[1]).read_bytes();assert len(key)==32
Path(sys.argv[2]).write_bytes(bytes.fromhex('302a300506032b6570032100')+key)
PY
while IFS= read -r -d '' catalog; do
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$key" -rawin -in "$catalog" -sigfile "$catalog.sig"
  python3 - "$catalog" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1]);d=json.loads(p.read_text());assert d['schemaVersion']==4
if p.parent.parent.name=='Profiles':
 assert all(m.get('installationProfile')==p.parent.name for m in d['models'] if m.get('status')=='enabled')
PY
done < <(find "$root/site" -name catalog.json -print0)
